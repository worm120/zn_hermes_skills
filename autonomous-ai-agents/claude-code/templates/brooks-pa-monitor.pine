//@version=5
indicator(title="Al Brooks Price Action Monitor", shorttitle="Brooks PA", overlay=true, max_bars_back=200)

// ============================================================
// Al Brooks 价格行为学监控指标
// 基于HTT PA课程第37-52章的可编程规则
//
// 安装: 复制到 TradingView Pine Editor, 保存后添加到图表
// ============================================================

// --- 参数 ---
atrLength = input.int(20, "ATR周期")
channelLookback = input.int(20, "通道检测周期")
signalStrength = input.int(50, "信号K线实体占比(%)", minval=30, maxval=90)
showLabels = input.bool(true, "显示信号标签")
showChannel = input.bool(true, "显示通道类型")
alertEnabled = input.bool(true, "启用警报")

// --- 基础计算 ---
atrVal = ta.atr(atrLength)
ema20 = ta.ema(close, 20)
body = math.abs(close - open)
bodyPct = body / (high - low) * 100
rangeHL = high - low

// 强牛/强熊K线
isStrongBull = close > open and bodyPct >= signalStrength and close >= high - 0.2 * rangeHL
isStrongBear = close < open and bodyPct >= signalStrength and close <= low + 0.2 * rangeHL

// --- 通道类型检测 ---
var string channelType = "未知"

detectChannel() =>
    float slope = 0.0
    int strongBull = 0, strongBear = 0
    float highest = high, lowest = low
    int aboveEMA = 0, belowEMA = 0
    float sumX = 0.0, sumY = 0.0, sumXY = 0.0, sumX2 = 0.0
    for i = 0 to channelLookback - 1
        sumX += i; sumY += close[i]; sumXY += i * close[i]; sumX2 += i * i
        if isStrongBull[i] then strongBull += 1
        if isStrongBear[i] then strongBear += 1
        if close[i] > ema20[i] then aboveEMA += 1 else belowEMA += 1
        highest := math.max(highest, high[i])
        lowest := math.min(lowest, low[i])
    float n = channelLookback
    slope := (n * sumXY - sumX * sumY) / (n * sumX2 - sumX * sumX)
    float ch = highest - lowest, atr = atrVal
    string result = "TR"
    if slope > 0.3 * atr / n
        if aboveEMA >= n * 0.7 and strongBull >= strongBear * 1.8 and ch <= 2.5 * atr
            result := "Tight Bull"
        else if strongBull > strongBear then result := "Broad Bull" else result := "Bull Channel"
    else if slope < -0.3 * atr / n
        if belowEMA >= n * 0.7 and strongBear >= strongBull * 1.8 and ch <= 2.5 * atr
            result := "Tight Bear"
        else if strongBear > strongBull then result := "Broad Bear" else result := "Bear Channel"
    result

if barstate.isconfirmed
    channelType := detectChannel()

// --- 摆动点检测 ---
bool isSwingHigh = high > nz(high[1]) and high > nz(high[2]) and high[1] > nz(high[3])
bool isSwingLow = low < nz(low[1]) and low < nz(low[2]) and low[1] < nz(low[3])

var int pushes = 0
var string pushDirection = ""
if isSwingHigh
    if pushDirection != "up" then pushes := 1 else pushes := math.min(pushes + 1, 5)
    pushDirection := "up"
if isSwingLow
    if pushDirection != "down" then pushes := 1 else pushes := math.min(pushes + 1, 5)
    pushDirection := "down"

// --- 信号检测 ---
bool breakoutUp = close > ta.highest(high[1], 10) and isStrongBull
bool breakoutDown = close < ta.lowest(low[1], 10) and isStrongBear
bool failedBreakoutUp = high > ta.highest(high[1], 10) and close < ta.highest(high[1], 10) - 0.3 * atrVal
bool failedBreakoutDown = low < ta.lowest(low[1], 10) and close > ta.lowest(low[1], 10) + 0.3 * atrVal
bool secondSignal = isStrongBull and nz(isStrongBull[1]) and not nz(isStrongBull[2]) or isStrongBear and nz(isStrongBear[1]) and not nz(isStrongBear[2])

float rh1 = ta.highest(high, 20), rh2 = ta.highest(high[10], 20)
float rl1 = ta.lowest(low, 20), rl2 = ta.lowest(low[10], 20)
bool doubleTop = math.abs(rh1 - rh2) <= 0.15 * atrVal and high >= rh1 - 0.1 * atrVal and isStrongBear
bool doubleBottom = math.abs(rl1 - rl2) <= 0.15 * atrVal and low <= rl1 + 0.1 * atrVal and isStrongBull

bool pullbackBuy = (channelType == "Tight Bull" or channelType == "Broad Bull") and close <= ema20 - 0.3 * atrVal and isStrongBull and close > ta.lowest(low[10], 10) + 0.2 * atrVal
bool pullbackSell = (channelType == "Tight Bear" or channelType == "Broad Bear") and close >= ema20 + 0.3 * atrVal and isStrongBear and close < ta.highest(high[10], 10) - 0.2 * atrVal

// --- 信号合成 ---
var signalType = ""
if pullbackBuy or doubleBottom or (breakoutUp and channelType != "Tight Bear") or (failedBreakoutDown and isStrongBull) or (secondSignal and isStrongBull)
    signalType := "BUY"
if pullbackSell or doubleTop or (breakoutDown and channelType != "Tight Bull") or (failedBreakoutUp and isStrongBear) or (secondSignal and isStrongBear)
    signalType := "SELL"

// --- 可视化 ---
if showChannel
    bgcolor(channelType == "Tight Bull" ? color.new(color.green, 95) :
            channelType == "Tight Bear" ? color.new(color.red, 95) :
            channelType == "Broad Bull" ? color.new(color.lime, 97) :
            channelType == "Broad Bear" ? color.new(color.maroon, 97) :
            channelType == "TR" ? color.new(color.gray, 97) : na)

if showLabels
    if signalType == "BUY"
        label.new(bar_index, low, "▲ BUY", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
        if alertEnabled then alert("买入信号: " + channelType, alert.freq_once_per_bar_close)
    if signalType == "SELL"
        label.new(bar_index, high, "▼ SELL", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
        if alertEnabled then alert("卖出信号: " + channelType, alert.freq_once_per_bar_close)

if showChannel and barstate.islast
    label.new(bar_index - 10, high + 2 * atrVal, "通道: " + channelType + " | 推: " + str.tostring(pushes) + pushDirection, style=label.style_label_center, color=color.blue, textcolor=color.white, size=size.normal)

plot(ema20, "EMA20", color=color.blue, linewidth=1)
plotshape(signalBar and isStrongBull, "强牛K", shape.triangleup, location.belowbar, color.green, size=size.tiny)
plotshape(signalBar and isStrongBear, "强熊K", shape.triangledown, location.abovebar, color.red, size=size.tiny)
